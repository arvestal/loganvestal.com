# Local dev port (Railway injects its own PORT in production — don't set it there)
PORT=8080

# Bare domain once the site has one, e.g. example.com. Leave unset during
# early development — www-redirect and canonical-URL logic no-op without it.
SITE_HOST=

# Set to 'production' in prod (enables secure cookies on the admin login)
NODE_ENV=development

# Full URL of this site, used to build the Google OAuth callback URL (no trailing slash)
BASE_URL=http://localhost:8080

# Google OAuth client — this can be a shared client used across multiple sites; it just needs
# each site's callback URL added as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# /admin login — comma-delimited list of Google emails allowed to sign in
ADMIN_EMAIL=
ADMIN_JWT_SECRET=

# Where uploaded artwork (originals + generated webp) is stored. Railway mounts a persistent
# volume here in production (e.g. /data/artwork); left unset locally it falls back to a
# gitignored .artwork-data/ folder.
ARTWORK_DATA_DIR=
