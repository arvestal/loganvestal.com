<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if pageTitle}}{{pageTitle}} — {{/if}}Logan Vestal</title>
  <meta name="description" content="{{#if metaDescription}}{{metaDescription}}{{else}}Logan Vestal — original artwork.{{/if}}">
  <meta name="robots" content="{{#if noIndex}}noindex, nofollow{{else}}index, follow{{/if}}">
  {{#if canonicalUrl}}<link rel="canonical" href="{{canonicalUrl}}">{{/if}}
  <link rel="stylesheet" href="/css/main.css?v={{assetVersion}}">
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">Logan Vestal</a>
    </div>
  </nav>

  <main class="main">
    {{{body}}}
  </main>

  <footer class="footer">
    <nav class="footer-nav">
      <a href="https://allenvestal.com">Allen</a>
      <a href="https://maryvestal.com">Mary</a>
      <a href="https://taylorvestal.com">Taylor</a>
      <a href="/admin">Admin</a>
    </nav>
    <p>&copy; {{currentYear}} Logan Vestal. All rights reserved.</p>
  </footer>

  <script src="/js/gallery-lightbox.js" defer></script>
  <script src="/js/admin-confirm.js" defer></script>
